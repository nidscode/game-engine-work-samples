<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DriftHangar</RootNamespace>
    <AssemblyName>DriftHangar.Game</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <StrideAssetCompilerVersion>4.2.0.2</StrideAssetCompilerVersion>
  </PropertyGroup>

  <!--
    Stride pulls in its runtime assemblies via the Stride.Engine meta-package.
    Versions should match whatever Stride editor version you opened the project with.
  -->
  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="4.2.0.*" />
    <PackageReference Include="Stride.Video" Version="4.2.0.*" />
    <PackageReference Include="Stride.Physics" Version="4.2.0.*" />
    <PackageReference Include="Stride.UI" Version="4.2.0.*" />
    <PackageReference Include="Stride.Core.Assets.CompilerApp" Version="4.2.0.*" PrivateAssets="contentfiles;analyzers" IncludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Scripts\**\*.cs" />
  </ItemGroup>

</Project>
