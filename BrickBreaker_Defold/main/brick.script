-- main/brick.script
--
-- A single brick. HP is set at spawn time by the controller via go.property
-- override. Each hit drops HP and updates the tint; at 0 HP we report
-- destruction (with points) and remove ourselves.

local events = require "modules.events"

go.property("hp", 1)                                 -- overridden at spawn
go.property("points_per_hp", 50)                     -- score awarded per HP at spawn time

-- Tints by HP. Index 1 = 1 HP, 2 = 2 HP, etc. The brick re-tints itself
-- on every hit so visual state stays in sync with HP.
local HP_COLORS = {
  vmath.vector4(0.45, 0.85, 0.75, 1),
  vmath.vector4(0.50, 0.85, 0.45, 1),
  vmath.vector4(0.95, 0.80, 0.35, 1),
  vmath.vector4(1.00, 0.50, 0.45, 1),
}

local function tint_for_hp(hp)
  hp = math.max(1, math.min(hp, #HP_COLORS))
  return HP_COLORS[hp]
end

local function apply_tint(self)
  -- Sprite component is at "#sprite" by convention.
  sprite.set_constant("#sprite", "tint", tint_for_hp(self.hp))
end

function init(self)
  self.max_hp = self.hp
  apply_tint(self)
end

function on_message(self, message_id, message, sender)
  if message_id == events.brick_hit then
    self.hp = self.hp - 1
    if self.hp <= 0 then
      local points = self.max_hp * self.points_per_hp
      msg.post("/game_controller", events.brick_destroyed, { points = points })
      go.delete()
    else
      apply_tint(self)
      -- A tiny squash tween makes the hit feel solid.
      go.animate(".", "scale", go.PLAYBACK_ONCE_PINGPONG,
                 vmath.vector3(1.1, 0.9, 1), go.EASING_OUTQUAD, 0.08)
    end
  end
end
